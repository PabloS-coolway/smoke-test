# Configuración del smoke test. Copia a `.env` y ajusta.
#   cp .env.example .env

# --- URLs de las tiendas (OBLIGATORIO) --------------------------------------
# La home (origen, SIN query) de cada tienda live. Verificadas 8/8 con estas.
STORE_EU_URL="https://www.coolway.com"
STORE_US_URL="https://coolway-us.com"

# --- Servidor ---------------------------------------------------------------
# Puerto (DigitalOcean App Platform usa 8080 por defecto).
PORT=8080

# Opcional: contraseña simple para que solo el equipo lance tests (si se pone,
# la UI la pide). Vacío = abierto.
SMOKE_PASSWORD=""

# --- Proxy por tienda (opcional) --------------------------------------------
# Algunas tiendas bloquean con bot-challenge a las IPs de DATACENTER en las
# peticiones profundas (/cart, /search). Se confirmó que la US lo hace desde
# CUALQUIER datacenter (fra y nyc) — no es geográfico. Solución: enrutar esa
# tienda por un proxy RESIDENCIAL de su país. Formato: http://usuario:clave@host:puerto
# Déjalo vacío para ir directo. La EU no lo necesita (va 8/8 directa).
STORE_EU_PROXY=""
STORE_US_PROXY=""

# --- Shopify Web Bot Auth (la vía OFICIAL y GRATIS) -------------------------
# Identifica al monitor como bot AUTORIZADO de la tienda (rate limits altos, no
# lo challengea). Aplica a las páginas del escaparate (/cart, /search, etc.).
# Generar en el Admin de CADA tienda: Online Store → Preferences → Crawler
# access → Create signature (caduca, máx 3 meses). Copia los dos valores aquí;
# Signature-Agent lo pone el código ("https://shopify.com"). Vacío = sin firma.
STORE_EU_SIGNATURE=""
STORE_EU_SIGNATURE_INPUT=""
STORE_US_SIGNATURE=""
STORE_US_SIGNATURE_INPUT=""

# --- Cabecera secreta del monitor (alternativa genérica, si hubiera WAF propio) --
# Como las tiendas son propias, en vez de pagar un proxy se puede allowlistear
# el monitor: el dev añade una excepción en la protección anti-bot de las
# tiendas ("saltar el challenge si llega esta cabecera") y el monitor la envía
# en todas sus peticiones. IP-independiente y escalable a las 12. Formato:
#   MONITOR_HEADER="X-Coolway-Monitor: un-secreto-largo-aleatorio"
MONITOR_HEADER=""

# --- Historial duradero: DigitalOcean Spaces (RECOMENDADO en producción) ----
# El disco de App Platform es EFÍMERO (se borra en cada redeploy). Para que el
# historial y las capturas sobrevivan, guárdalos en un bucket de DO Spaces
# (S3-compatible). Si estas variables NO están, se usa disco local (solo dev).
#
# Crea un Space en DO (p. ej. región fra1), y una Access Key en API > Spaces Keys.
#   SPACES_ENDPOINT: el host regional, con https:// y SIN el nombre del bucket.
#   SPACES_BUCKET:   el nombre del Space.
#   SPACES_REGION:   la región del Space (fra1, nyc3, ...).
SPACES_KEY=""
SPACES_SECRET=""
SPACES_BUCKET=""
SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
SPACES_REGION="fra1"
# Opcional: carpeta dentro del bucket (por defecto "runs").
SPACES_PREFIX="runs"
