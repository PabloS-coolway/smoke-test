{
  "name": "coolway-smoke",
  "version": "0.1.0",
  "private": true,
  "description": "Smoke test automatizado de las tiendas Shopify de Coolway (EU y US). Web-app: Catalina lanza el test y ve un informe verde/rojo con capturas. Corre contra la tienda live tras cada deploy.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "pixelmatch": "^5.3.0",
    "playwright": "1.62.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
